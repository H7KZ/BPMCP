# App .env
# On the server this file is NOT used: CI writes ~/mcp/<env>/.env from GitHub Secrets
# (see deploy/deploy.sh). Never hand-place this file into a deploy target.

NODE_ENV=development
PORT=3000
METRICS_PORT=9090

DATABASE_URL=postgres://readonly_user:password@localhost:5432/insis

# optional for local dev
REDIS_URL=redis://localhost:6379
