{
	"uid": "mcp-logs",
	"title": "MCP — Logs",
	"tags": [
		"mcp"
	],
	"timezone": "browser",
	"editable": true,
	"schemaVersion": 39,
	"version": 1,
	"refresh": "30s",
	"time": {
		"from": "now-1h",
		"to": "now"
	},
	"annotations": {
		"list": []
	},
	"templating": {
		"list": [
			{
				"name": "env",
				"label": "Environment",
				"type": "custom",
				"query": "production,development",
				"includeAll": false,
				"multi": false,
				"current": {
					"text": "production",
					"value": "production"
				}
			}
		]
	},
	"panels": [
		{
			"id": 1,
			"type": "timeseries",
			"title": "Log volume by level",
			"datasource": {
				"type": "loki",
				"uid": "Loki"
			},
			"gridPos": {
				"h": 7,
				"w": 24,
				"x": 0,
				"y": 0
			},
			"targets": [
				{
					"refId": "A",
					"expr": "sum by (level) (count_over_time({service=\"mcp\", env=~\"$env\"}[5m]))",
					"legendFormat": "{{level}}"
				}
			]
		},
		{
			"id": 2,
			"type": "logs",
			"title": "mcp logs ($env)",
			"datasource": {
				"type": "loki",
				"uid": "Loki"
			},
			"gridPos": {
				"h": 18,
				"w": 24,
				"x": 0,
				"y": 7
			},
			"options": {
				"showTime": true,
				"wrapLogMessage": true,
				"prettifyLogMessage": true,
				"enableLogDetails": true,
				"dedupStrategy": "none",
				"sortOrder": "Descending"
			},
			"targets": [
				{
					"refId": "A",
					"expr": "{service=\"mcp\", env=~\"$env\"}"
				}
			]
		}
	]
}
