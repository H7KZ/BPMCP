# Monitoring .env

# Grafana admin login (only reachable via the SSH tunnel)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-long-random

DISCORD_WEBHOOK_URL=

# Retention. Metric cardinality is tiny, so 400d is cheap and covers the thesis
# adoption curve; the size cap is a safety valve (whichever limit hits first wins)
PROMETHEUS_RETENTION_TIME=400d
PROMETHEUS_RETENTION_SIZE=3GB

# Host's docker group gid, so Alloy can read the Docker socket
# getent group docker | cut -d: -f3
DOCKER_GID=989
